{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "debug_prompt": {
    "template": " Debugging ",
    "foreground": "#ffffff",
    "background": "transparent"
  },
  "upgrade": {
    "source": "cdn",
    "interval": "24h",
    "auto": true,
    "notice": true
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "claude",
          "style": "diamond",
          "leading_diamond": "",
          "template": " 󰯉 {{ .Model.DisplayName }} ",
          "foreground": "#ffffff",
          "background": "#ff6b35",
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "claude",
          "style": "powerline",
          "powerline_symbol": "",
          "template": "{{ if .Effort }}  {{ .Effort.Level }} {{ end }}",
          "background": "#303030",
          "foreground_templates": [
            "{{ if and .Effort (eq .Effort.Level \"low\") }}#00aa55{{ end }}",
            "{{ if and .Effort (eq .Effort.Level \"medium\") }}#ffd700{{ end }}",
            "{{ if and .Effort (eq .Effort.Level \"high\") }}#ffa500{{ end }}",
            "{{ if and .Effort (eq .Effort.Level \"xhigh\") }}#ff4500{{ end }}",
            "{{ if and .Effort (eq .Effort.Level \"max\") }}#ff0000{{ end }}"
          ],
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "claude",
          "style": "powerline",
          "powerline_symbol": "",
          "template": "{{ if and .Thinking .Thinking.Enabled }}  Thinking {{ end }}",
          "foreground": "#ffffff",
          "background": "#9b59b6",
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "claude",
          "style": "powerline",
          "powerline_symbol": "",
          "template": "{{ if .Workspace.Repo }} {{ if eq .Workspace.Repo.Host \"github.com\" }}\uf09b{{ else if eq .Workspace.Repo.Host \"gitlab.com\" }}\uf296{{ else }}{{ .Workspace.Repo.Host }}{{ end }} {{ .Workspace.Repo.Name }} {{ end }}",
          "foreground": "#e4e4e4",
          "foreground_templates": [
            "{{ if and .Workspace.Repo (eq .Workspace.Repo.Host \"github.com\") }}#f0f6fb{{ end }}",
            "{{ if and .Workspace.Repo (eq .Workspace.Repo.Host \"gitlab.com\") }}#fca325{{ end }}"
          ],
          "background": "#5c5c5c",
          "background_templates": [
            "{{ if and .Workspace.Repo (eq .Workspace.Repo.Host \"github.com\") }}#14191e{{ end }}",
            "{{ if and .Workspace.Repo (eq .Workspace.Repo.Host \"gitlab.com\") }}#e24329{{ end }}"
          ],
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "template": " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<#ef5350>  {{ .Staging.String }}</>{{ end }} ",
          "foreground": "#011627",
          "background": "#fffb38",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ffeb95{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#c5e478{{ end }}",
            "{{ if gt .Ahead 0 }}#c792ea{{ end }}",
            "{{ if gt .Behind 0}}#c792ea{{ end }}"
          ],
          "options": {
            "branch_icon": " "
          },
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "claude",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "template": "{{ if .PR }}  #{{ .PR.Number }} {{ if eq .PR.ReviewState \"approved\" }}Approved {{ else if eq .PR.ReviewState \"changes_requested\" }}Changes Requested {{ else if eq .PR.ReviewState \"draft\" }}Draft {{ else }}Pending {{ end }} {{ end }}",
          "foreground": "#e4e4e4",
          "background": "#F39C12",
          "background_templates": [
            "{{ if and .PR (eq .PR.ReviewState \"approved\") }}#2ECC71{{ end }}",
            "{{ if and .PR (eq .PR.ReviewState \"changes_requested\") }}#E74C3C{{ end }}",
            "{{ if and .PR (eq .PR.ReviewState \"draft\") }}#7F8C8D{{ end }}"
          ],
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "template": " {{ .Path }} ",
          "foreground": "#e4e4e4",
          "background": "#444444",
          "options": {
            "style": "full"
          },
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "dotnet",
          "style": "powerline",
          "powerline_symbol": "",
          "template": " 󰪮 {{ .Full }} ",
          "foreground": "#f7f7f7",
          "background": "#613494",
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "java",
          "style": "powerline",
          "powerline_symbol": "",
          "template": "  {{ .Full }} ",
          "foreground": "#F89B24",
          "background": "#5886A4",
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "go",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#ffffff",
          "background": "#7FD5EA",
          "template": "  {{ .Full }} ",
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "rust",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#193549",
          "background": "#99908a",
          "template": "  {{ .Full }} "
        },
        {
          "type": "lua",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "white",
          "background": "blue",
          "template": "  {{ .Full }} "
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "",
          "template": "  {{ .Full }} ",
          "foreground": "#FFDE58",
          "background": "#3975A5",
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "",
          "template": "  {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "foreground": "#3c873a",
          "background": "#303030",
          "options": {
            "fetch_package_manager": true,
            "npm_icon": "<#cb0000></>",
            "yarn_icon": "<#2e2a64></>"
          },
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "angular",
          "style": "powerline",
          "powerline_symbol": "",
          "template": " 󰚲 {{ .Full }} ",
          "foreground": "#b3b3b3",
          "background": "#a6120d",
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "docker",
          "style": "powerline",
          "powerline_symbol": "",
          "template": "{{ if .Containers }}{{ range .Containers }}  {{ .ID }} {{ .Names }}:{{ if .Ports }}{{ $pp := split \"->\" .Ports }}{{ $hp := split \":\" $pp._0 }}{{ $hp._1 }}{{ end }} {{ end }}{{ end }}",
          "foreground": "#ffffff",
          "background": "#2496ED",
          "options": {
            "display_mode": "environment"
          },
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "aws",
          "style": "powerline",
          "powerline_symbol": "",
          "template": "  {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }}",
          "foreground": "#FF9C08",
          "background": "#2C3644",
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "az",
          "style": "powerline",
          "powerline_symbol": "",
          "template": "  {{ .EnvironmentName }}",
          "foreground": "#088DD7",
          "background": "#FFFFFF",
          "options": {
            "source": "pwsh"
          },
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "time",
          "style": "diamond",
          "trailing_diamond": "",
          "template": " 󰃰 {{ .CurrentDate | date .Format }} ",
          "foreground": "#ffffff",
          "background": "#0077c2",
          "options": {
            "time_format": "Mon, 02 Jan 2006 | 15:04:05"
          },
          "cache": {
            "duration": "none"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "claude",
          "style": "plain",
          "template": " Session: {{ .FiveHourUsage }}% ",
          "foreground_templates": [
            "{{ if le .FiveHourUsage 10 }}#00AA55{{ end }}",
            "{{ if and (ge .FiveHourUsage 11) (le .FiveHourUsage 20) }}#33CC66{{ end }}",
            "{{ if and (ge .FiveHourUsage 21) (le .FiveHourUsage 30) }}#66FF66{{ end }}",
            "{{ if and (ge .FiveHourUsage 31) (le .FiveHourUsage 40) }}#99FF33{{ end }}",
            "{{ if and (ge .FiveHourUsage 41) (le .FiveHourUsage 50) }}#CCFF00{{ end }}",
            "{{ if and (ge .FiveHourUsage 51) (le .FiveHourUsage 60) }}#FFFF00{{ end }}",
            "{{ if and (ge .FiveHourUsage 61) (le .FiveHourUsage 70) }}#FFD700{{ end }}",
            "{{ if and (ge .FiveHourUsage 71) (le .FiveHourUsage 80) }}#FFA500{{ end }}",
            "{{ if and (ge .FiveHourUsage 81) (le .FiveHourUsage 90) }}#FF4500{{ end }}",
            "{{ if and (ge .FiveHourUsage 91) (le .FiveHourUsage 100) }}#FF0000{{ end }}"
          ],
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "text",
          "style": "plain",
          "template": " | ",
          "foreground": "#999999"
        },
        {
          "type": "claude",
          "style": "plain",
          "template": " Weekly: {{ .SevenDayUsage }}% ",
          "foreground_templates": [
            "{{ if le .SevenDayUsage 10 }}#00AA55{{ end }}",
            "{{ if and (ge .SevenDayUsage 11) (le .SevenDayUsage 20) }}#33CC66{{ end }}",
            "{{ if and (ge .SevenDayUsage 21) (le .SevenDayUsage 30) }}#66FF66{{ end }}",
            "{{ if and (ge .SevenDayUsage 31) (le .SevenDayUsage 40) }}#99FF33{{ end }}",
            "{{ if and (ge .SevenDayUsage 41) (le .SevenDayUsage 50) }}#CCFF00{{ end }}",
            "{{ if and (ge .SevenDayUsage 51) (le .SevenDayUsage 60) }}#FFFF00{{ end }}",
            "{{ if and (ge .SevenDayUsage 61) (le .SevenDayUsage 70) }}#FFD700{{ end }}",
            "{{ if and (ge .SevenDayUsage 71) (le .SevenDayUsage 80) }}#FFA500{{ end }}",
            "{{ if and (ge .SevenDayUsage 81) (le .SevenDayUsage 90) }}#FF4500{{ end }}",
            "{{ if and (ge .SevenDayUsage 91) (le .SevenDayUsage 100) }}#FF0000{{ end }}"
          ],
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "text",
          "style": "plain",
          "template": " | ",
          "foreground": "#999999"
        },
        {
          "type": "claude",
          "style": "plain",
          "template": " Context: {{ .TokenUsagePercent }}% ",
          "foreground_templates": [
            "{{ if le .TokenUsagePercent 10 }}#00AA55{{ end }}",
            "{{ if and (ge .TokenUsagePercent 11) (le .TokenUsagePercent 20) }}#33CC66{{ end }}",
            "{{ if and (ge .TokenUsagePercent 21) (le .TokenUsagePercent 30) }}#66FF66{{ end }}",
            "{{ if and (ge .TokenUsagePercent 31) (le .TokenUsagePercent 40) }}#99FF33{{ end }}",
            "{{ if and (ge .TokenUsagePercent 41) (le .TokenUsagePercent 50) }}#CCFF00{{ end }}",
            "{{ if and (ge .TokenUsagePercent 51) (le .TokenUsagePercent 60) }}#FFFF00{{ end }}",
            "{{ if and (ge .TokenUsagePercent 61) (le .TokenUsagePercent 70) }}#FFD700{{ end }}",
            "{{ if and (ge .TokenUsagePercent 71) (le .TokenUsagePercent 80) }}#FFA500{{ end }}",
            "{{ if and (ge .TokenUsagePercent 81) (le .TokenUsagePercent 90) }}#FF4500{{ end }}",
            "{{ if and (ge .TokenUsagePercent 91) (le .TokenUsagePercent 100) }}#FF0000{{ end }}"
          ],
          "cache": {
            "duration": "none"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "claude",
          "style": "plain",
          "template": " Session Limit Resets At: {{ .FiveHourResetsAt | date \"15:04\" }} ",
          "foreground": "#999999",
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "claude",
          "style": "plain",
          "template": "(Resets In: {{ $d := .FiveHourResetsIn.String }}{{ if contains \"h\" $d }}{{ $p := split \"h\" $d }}{{ $p._0 }}h {{ (split \"m\" $p._1)._0 }}m{{ else }}{{ (split \"m\" $d)._0 }}m{{ end }}) ",
          "foreground": "#999999",
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "text",
          "style": "plain",
          "template": " | ",
          "foreground": "#999999"
        },
        {
          "type": "claude",
          "style": "plain",
          "template": " Weekly Limit Resets At: {{ .SevenDayResetsAt | date \"Mon, 02 Jan • 15:04\" }} ",
          "foreground": "#999999",
          "cache": {
            "duration": "none"
          }
        },
        {
          "type": "claude",
          "style": "plain",
          "template": "(Resets In: {{ $d := .SevenDayResetsIn.String }}{{ if contains \"h\" $d }}{{ $p := split \"h\" $d }}{{ $hrs := atoi $p._0 }}{{ $days := div $hrs 24 }}{{ $remH := mod $hrs 24 }}{{ $mins := (split \"m\" $p._1)._0 }}{{ if gt $days 0 }}{{ $days }}d {{ end }}{{ $remH }}h {{ $mins }}m{{ else }}{{ (split \"m\" $d)._0 }}m{{ end }})",
          "foreground": "#999999",
          "cache": {
            "duration": "none"
          }
        }
      ]
    }
  ],
  "version": 3
}
